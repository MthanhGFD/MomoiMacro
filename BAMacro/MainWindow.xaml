<Window x:Class="BAMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA Macro" 
        Icon="Assets/app.ico"
        Height="770" Width="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Nunito, Arial"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Soft Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" 
                          Color="#4b5563" 
                          Opacity="0.08" 
                          BlurRadius="16" 
                          ShadowDepth="4" 
                          Direction="270"/>

        <DropShadowEffect x:Key="ButtonShadow" 
                          Color="#cf6a87" 
                          Opacity="0.3" 
                          BlurRadius="10" 
                          ShadowDepth="3" 
                          Direction="270"/>

        <!-- Plain button template: content only (styling done by inner Border) -->
        <ControlTemplate x:Key="PlainButton" TargetType="Button">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </ControlTemplate>
    </Window.Resources>

    <!-- Outer Main Border with rounded corners -->
    <Border Background="#f3f4f6" 
            CornerRadius="16" 
            BorderBrush="#e5e7eb" 
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>   <!-- Custom Title Bar -->
                <RowDefinition Height="64"/>   <!-- Header Banner -->
                <RowDefinition Height="*"/>    <!-- Main Content (2 Columns) -->
                <RowDefinition Height="36"/>   <!-- Footer / Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM TITLE BAR -->
            <Border Grid.Row="0" Background="#f8fafc" BorderBrush="#e5e7eb" BorderThickness="0,0,0,1" CornerRadius="15,15,0,0" MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon Circle -->
                        <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,10,0">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/student.png" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="BA Macro" FontWeight="SemiBold" FontSize="14" Foreground="#374151" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Control Buttons (Min, Close) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Click="BtnMinimize_Click" Width="36" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="─" FontSize="11" Foreground="#6b7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Click="BtnClose_Click" Width="36" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="✕" FontSize="12" Foreground="#6b7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. HEADER BANNER -->
            <Grid Grid.Row="1" Margin="28,14,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BLUE ARCHIVE " FontSize="22" FontWeight="Bold" Foreground="#1f2937"/>
                    <TextBlock Text="MACRO" FontSize="22" FontWeight="Bold" Foreground="#cf6a87"/>
                </StackPanel>

                <!-- Right: Status Pill Badge -->
                <Border Grid.Column="1" VerticalAlignment="Center" 
                        Name="BadgeStatus"
                        Background="#d1fae5" 
                        CornerRadius="20" 
                        Padding="14,6" 
                        BorderBrush="#a7f3d0" 
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Name="DotStatus" Width="8" Height="8" Fill="#10b981" Margin="0,0,7,0"/>
                        <TextBlock Name="TxtStatus" Text="READY" FontWeight="Bold" FontSize="12" Foreground="#047857"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. MAIN BODY (2 COLUMNS) -->
            <Grid Grid.Row="2" Margin="28,12,28,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/> <!-- Left: Controls -->
                    <ColumnDefinition Width="2*"/> <!-- Right: Student & Hotkeys -->
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT COLUMN: CONTROLS ================= -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Card 1: Configuration -->
                    <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="GAME &amp; MACRO CONFIGURATION" FontWeight="Bold" FontSize="11" Foreground="#9ca3af" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <!-- Target Process -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Target Process" FontSize="12" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                    <TextBox Name="TxtTargetExe" Text="BlueArchive.exe" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                             Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1" FontSize="13" FontWeight="Medium"
                                             LostFocus="Settings_LostFocus">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>

                                <!-- Skill Delay (ms) -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Delay (ms)" FontSize="12" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                    <TextBox Name="TxtDelayMs" Text="20" Height="36" Padding="10,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1" FontSize="13" FontWeight="Bold"
                                             LostFocus="Settings_LostFocus">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Start/Stop toggle (Ctrl+1) + Record toggle (Ctrl+2) -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- START / STOP -->
                        <Button Grid.Column="0" Name="BtnToggle" Click="BtnToggle_Click" Height="62" Margin="0,0,8,0" Cursor="Hand"
                                Template="{StaticResource PlainButton}" Effect="{StaticResource ButtonShadow}">
                            <Border Name="BorderBtn" Background="#cf6a87" CornerRadius="12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Name="TxtBtnIcon" Text="▶" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Name="TxtBtnText" Text="Start" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <Border Name="BorderPill" Background="#b95572" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl + 1" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- RECORD -->
                        <Button Grid.Column="1" Name="BtnRecord" Click="BtnRecord_Click" Height="62" Margin="8,0,0,0" Cursor="Hand"
                                Template="{StaticResource PlainButton}">
                            <Border Name="BorderRecord" Background="White" CornerRadius="12" BorderBrush="#d1d5db" BorderThickness="1.5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Name="DotRecord" Width="12" Height="12" Fill="#4b5563" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Name="TxtRecord" Text="Record" FontSize="17" FontWeight="Bold" Foreground="#4b5563" VerticalAlignment="Center"/>
                                    <Border Name="PillRecord" Background="#e5e7eb" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Name="TxtRecordPill" Text="Ctrl + 2" FontSize="12" FontWeight="Bold" Foreground="#6b7280"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>

                    <!-- Card 3: Saved key positions -->
                    <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="18" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Name="TxtKeysHeader" Text="SAVED KEYS (0)" FontWeight="Bold" FontSize="11" Foreground="#9ca3af" VerticalAlignment="Center"/>
                                <Button Content="Open INI" Click="BtnOpenIni_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="11" Background="#f3f4f6" BorderBrush="#e5e7eb" Cursor="Hand"/>
                            </Grid>

                            <!-- 16:9 game-screen preview: keys shown at their saved positions -->
                            <Viewbox Grid.Row="1" Stretch="Uniform">
                                <Grid Width="1600" Height="900">
                                    <Border Background="#faf5f7" CornerRadius="24"/>
                                    <!-- Grid lines (25% / 50% / 75%) -->
                                    <Canvas IsHitTestVisible="False">
                                        <Line X1="400"  Y1="0" X2="400"  Y2="900" Stroke="#f3dbe3" StrokeThickness="2" StrokeDashArray="6 6"/>
                                        <Line X1="800"  Y1="0" X2="800"  Y2="900" Stroke="#f3dbe3" StrokeThickness="2" StrokeDashArray="6 6"/>
                                        <Line X1="1200" Y1="0" X2="1200" Y2="900" Stroke="#f3dbe3" StrokeThickness="2" StrokeDashArray="6 6"/>
                                        <Line X1="0" Y1="225" X2="1600" Y2="225" Stroke="#f3dbe3" StrokeThickness="2" StrokeDashArray="6 6"/>
                                        <Line X1="0" Y1="450" X2="1600" Y2="450" Stroke="#f3dbe3" StrokeThickness="2" StrokeDashArray="6 6"/>
                                        <Line X1="0" Y1="675" X2="1600" Y2="675" Stroke="#f3dbe3" StrokeThickness="2" StrokeDashArray="6 6"/>
                                    </Canvas>
                                    <Rectangle Stroke="#fbcfe8" StrokeThickness="4" StrokeDashArray="4 3" RadiusX="24" RadiusY="24"/>

                                    <TextBlock Name="TxtNoKeys" Text="Ctrl + 2 → hover → press key" FontSize="48" Foreground="#e5c3cf"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <ItemsControl Name="ListKeys">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}" Height="64" CornerRadius="32" Background="#cf6a87"
                                                        BorderBrush="White" BorderThickness="4" ToolTip="{Binding Tip}">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#cf6a87" Opacity="0.35" BlurRadius="14" ShadowDepth="3" Direction="270"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="{Binding Label}" FontSize="30" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= RIGHT COLUMN: ASSISTANT & HOTKEYS ================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Student Artwork (1:1) -->
                        <RowDefinition Height="*"/>    <!-- Skill Hotkeys List -->
                    </Grid.RowDefinitions>

                    <!-- Student Artwork Card: image fills the whole card, square 1:1 -->
                    <Border Grid.Row="0" CornerRadius="14" Margin="0,0,0,12" Effect="{StaticResource CardShadow}"
                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                        <Border.Background>
                            <ImageBrush ImageSource="Assets/student.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <!-- Skill Hotkeys Card -->
                    <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="16" Effect="{StaticResource CardShadow}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SKILL HOTKEYS" FontWeight="Bold" FontSize="11" Foreground="#9ca3af" Margin="0,0,0,10"/>

                            <!-- Hotkey Q -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#fce7f3" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="Q" FontWeight="Bold" FontSize="13" Foreground="#cf6a87" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Skill 1 + Click" FontSize="12.5" FontWeight="SemiBold" Foreground="#4b5563" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Hotkey W -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#fce7f3" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="W" FontWeight="Bold" FontSize="13" Foreground="#cf6a87" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Skill 2 + Click" FontSize="12.5" FontWeight="SemiBold" Foreground="#4b5563" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Hotkey E -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#fce7f3" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="E" FontWeight="Bold" FontSize="13" Foreground="#cf6a87" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Skill 3 + Click" FontSize="12.5" FontWeight="SemiBold" Foreground="#4b5563" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Record + Key -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" BorderBrush="#f472b6" BorderThickness="1" CornerRadius="6" Padding="6,2" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="Record + Key" FontWeight="SemiBold" FontSize="11" Foreground="#cf6a87" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Save position" FontSize="12" Foreground="#6b7280" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. FOOTER / STATUS BAR -->
            <Border Grid.Row="3" Background="#f8fafc" BorderBrush="#e5e7eb" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15">
                <Grid Margin="20,0,20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Name="DotGameConn" Width="7" Height="7" Fill="#9ca3af" Margin="0,0,6,0"/>
                        <TextBlock Name="TxtGameConn" Text="Waiting for game..." FontSize="11.5" Foreground="#6b7280"/>
                    </StackPanel>
                    <TextBlock Text="BA Macro v2.0" FontSize="11" Foreground="#9ca3af" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
